{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "appstore": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "vercel_entry:app",
      "installCommand": "pip install -r requirements.txt"
    },
    "blob": {
      "root": "blob-api",
      "installCommand": "npm install"
    }
  },
  "rewrites": [
    {
      "source": "/api/blob-upload",
      "destination": {
        "type": "service",
        "service": "blob",
        "path": "/api/blob-upload"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "appstore"
      }
    }
  ]
}
