{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "appstore": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "vercel_entry:app",
      "installCommand": "pip install -r requirements.txt"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "appstore"
      }
    }
  ]
}
